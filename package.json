{
  "name": "veriq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma pequeña de gestión de QA",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "test:db": "node --env-file-if-exists=.env --test --test-reporter=spec tests/database/*.test.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
