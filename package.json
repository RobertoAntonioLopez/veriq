{
  "name": "veriq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma pequeña de gestión de QA",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/app.js && node --check src/server.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
